# CDP API Credentials
# Get these from https://portal.cdp.coinbase.com
CDP_API_KEY_ID=your_api_key_id_here
CDP_API_KEY_SECRET=your_api_key_secret_here
CDP_WALLET_SECRET=your_wallet_secret_here

# Optional: Import an existing private key
# Provide your own private key to import (without 0x prefix)
# If not provided, a temporary key will be generated for demonstration
# IMPORT_PRIVATE_KEY=your_64_character_hex_private_key_here